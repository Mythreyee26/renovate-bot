    def newPatch = newMRs.findAll { it.updateType == 'patch' }.size()
    def oldMajor = oldMRs.findAll { it.updateType == 'major' }.size()
    def oldMinor = oldMRs.findAll { it.updateType == 'minor' }.size()
    def oldPatch = oldMRs.findAll { it.updateType == 'patch' }.size()

    def cs = 'width:48%;vertical-align:top;padding:0;background:transparent;border:none;'
    def ls = 'font-size:13px;color:#555;padding:3px 0;background:transparent;border:none;'
    def vs = 'font-size:13px;font-weight:bold;color:#2c3e50;padding:3px 0 3px 10px;background:transparent;border:none;'
    def hs = 'font-size:13px;font-weight:bold;color:#2980b9;padding:4px 0 6px 0;background:transparent;border:none;'

    return """<div style="background:#eaf4fb;border:1px solid #3498db;border-radius:6px;padding:16px 20px;margin-bottom:24px;">
