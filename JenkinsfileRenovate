def emailHeader(String title) {
    return """<html><head></head>
<body style="font-family:Arial,sans-serif;font-size:14px;color:#333;margin:0;padding:20px;">
<h2 style="color:#2c3e50;border-bottom:3px solid #3498db;padding-bottom:8px;">${title}</h2>
