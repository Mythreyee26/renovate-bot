def badgeSpan(String color, String text) {
    return """<span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:bold;margin-right:3px;background:${color};color:#fff;">${text}</span>"""
}

def buildMergedMRListUrl(String repoPath) {
    def gitlabHost = 'https://gitlab.example.com'
    def cleanPath  = repoPath.toLowerCase()
    return "${gitlabHost}/${cleanPath}/-/merge_requests?sort=created_date&state=merged&first_page_size=100"
}

