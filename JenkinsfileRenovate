// ── Full Email Renderers ─────────────────────────────────────────

def renderNoMrEmail(String botUsername, String buildUrl, String buildNumber) {
    return emailHeader('Renovate — No Open Dependency MRs') +
        """<p>No open Merge Requests found created by <strong>${botUsername}</strong>.</p>
<p>All tracked dependencies are up to date.</p>""" +
        emailFooter(buildUrl, buildNumber)
}

def renderLeadEmail(List enrichedMRs, List automergedMRs, String leadUsername, String botUsername, String buildUrl, String buildNumber) {
    def newMRs = enrichedMRs.findAll { it.isNew }
    def oldMRs = enrichedMRs.findAll { !it.isNew }

    def h3S = 'color:#2c3e50;margin-top:28px;margin-bottom:6px;border-left:4px solid #3498db;padding-left:10px;'

    def body = emailHeader("Renovate — ${enrichedMRs.size()} Open Dependency MR${enrichedMRs.size() > 1 ? 's' : ''} (Lead: @${leadUsername})")
    body += """<p>Hi <strong>@${leadUsername}</strong>, here is the full summary of all open Renovate MRs.</p>"""
    body += renderSummaryBlock(newMRs, oldMRs, automergedMRs)

    if (newMRs) {
        body += """<h3 style="${h3S}">&#128680; Newly Created — This Pipeline Run (${newMRs.size()})</h3>"""
        body += renderMRSubsections(newMRs)
    }

    if (oldMRs) {
        body += """<h3 style="${h3S}">&#128337; Old Open MRs (${oldMRs.size()})</h3>"""
        body += renderMRSubsections(oldMRs)
    }

    body += """<h3 style="${h3S}">&#10003; Auto-Merged Patches — This Pipeline Run (${automergedMRs.size()})</h3>
<p style="background:#eafaf1;border:1px solid #27ae60;border-radius:4px;padding:4px 10px;font-size:12px;color:#1e8449;display:inline-block;margin-bottom:6px;">
  These patch MRs were automatically merged after passing compatibility tests during this pipeline run. No action required.</p>"""
    body += automergedMRs ? buildAutomergedTable(automergedMRs) : '<p style="color:#888;">No auto-merged patches in this pipeline run.</p>'

    body += emailFooter(buildUrl, buildNumber)
    return body
}

def renderReviewerEmail(String username, List mrs, String reviewType, String buildUrl, String buildNumber) {
    def newMRs   = mrs.findAll { it.isNew }
    def oldMRs   = mrs.findAll { !it.isNew }
    def isDocker = reviewType == 'docker'
    def typeLabel = isDocker ? 'Dockerfile MR' : 'MR'
    def emailTitle = isDocker
        ? "Renovate — Dockerfile MRs Assigned to You (@${username})"
        : "Renovate — Open MRs Assigned to You (@${username})"

    def h3S = 'color:#2c3e50;margin-top:28px;margin-bottom:6px;border-left:4px solid #3498db;padding-left:10px;'

    def body = emailHeader(emailTitle)
    body += """<p>Hi <strong>@${username}</strong>, you have <strong>${mrs.size()}</strong> open <strong>${typeLabel}${mrs.size() > 1 ? 's' : ''}</strong> to review.</p>"""
    body += renderSummaryBlock(newMRs, oldMRs, [])

    if (newMRs) {
        body += """<h3 style="${h3S}">&#128680; Newly Created — This Pipeline Run (${newMRs.size()})</h3>"""
        body += renderMRSubsections(newMRs)
    }
    if (oldMRs) {
        body += """<h3 style="${h3S}">&#128337; Old Open MRs (${oldMRs.size()})</h3>"""
        body += renderMRSubsections(oldMRs)
    }

     body += """<p style="margin-top:14px;"><strong>Action required:</strong> Open each link, review the dependency changes, and approve or request changes.</p>"""
    body += emailFooter(buildUrl, buildNumber)
    return body
}

// ── Subsection renderers ─────────────────────────────────────────

def renderMRSubsections(List mrs) {
    def html = ''
    def groups = [
        [type: 'major', color: '#e67e22', label: 'Major'],
        [type: 'minor', color: '#3498db', label: 'Minor'],
        [type: 'patch', color: '#27ae60', label: 'Patch'],
        [type: 'other', color: '#95a5a6', label: 'Other']
    ]
    groups.each { g ->
        def subset = mrs.findAll { it.updateType == g.type }
        if (subset) {
            html += """<h4 style="margin:12px 0 4px 0;color:${g.color};">${g.label} (${subset.size()})</h4>"""
            html += buildMRTable(subset)
        }
    }
    return html
}

