    <tr>
      <td style="${cs}padding-right:20px;">
        <table style="width:100%;border-collapse:collapse;">
          <tr><td colspan="2" style="${hs}">&#128680; New (this pipeline run) — ${newMRs.size()} MR${newMRs.size() != 1 ? 's' : ''}</td></tr>
          <tr><td style="${ls}">Major open</td><td style="${vs}">${newMajor}</td></tr>
          <tr><td style="${ls}">Minor open</td><td style="${vs}">${newMinor}</td></tr>
          <tr><td style="${ls}">Patch open</td><td style="${vs}">${newPatch}</td></tr>
          <tr><td style="${ls}">Auto-merged (this run)</td><td style="${vs}">${enrichedAutomerged.size()}</td></tr>
        </table>
      </td>
      <td style="${cs}border-left:2px solid #b3d4ea;padding-left:20px;">
        <table style="width:100%;border-collapse:collapse;">
          <tr><td colspan="2" style="${hs}">&#128337; Old Open — ${oldMRs.size()} MR${oldMRs.size() != 1 ? 's' : ''}</td></tr>
          <tr><td style="${ls}">Major open</td><td style="${vs}">${oldMajor}</td></tr>
          <tr><td style="${ls}">Minor open</td><td style="${vs}">${oldMinor}</td></tr>
          <tr><td style="${ls}">Patch open</td><td style="${vs}">${oldPatch}</td></tr>
        </table>
      </td>
    </tr>
