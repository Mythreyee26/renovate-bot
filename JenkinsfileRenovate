def emailFooter(String buildUrl, String buildNumber) {
    return """<p style="margin-top:30px;font-size:0.82em;color:#aaa;border-top:1px solid #eee;padding-top:10px;">
  Jenkins Build: <a href="${buildUrl}" style="color:#2980b9;text-decoration:none;">#${buildNumber}</a> &nbsp;|&nbsp;
  Powered by <strong>Renovate Bot</strong></p></body></html>"""
