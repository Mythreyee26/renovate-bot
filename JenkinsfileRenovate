// ── MR Detail Table ──────────────────────────────────────────────

def buildMRTable(List mrs) {
    def typeColors = [major: '#e67e22', minor: '#3498db', patch: '#27ae60', other: '#95a5a6']
    def td = 'padding:7px 10px;border-bottom:1px solid #ddd;vertical-align:top;font-size:13px;'
    def rows = ''
    mrs.eachWithIndex { mr, idx ->
        def typeBadge   = badgeSpan(typeColors[mr.updateType] ?: '#95a5a6', mr.updateType.toUpperCase())
        def dockerBadge = mr.isDockerMR ? badgeSpan('#1abc9c', 'DOCKER') : ''
        def ageBadge    = mr.isMerged ? badgeSpan('#8e44ad', 'AUTO-MERGED')
                          : (mr.isNew ? badgeSpan('#e74c3c', 'NEW') : badgeSpan('#7f8c8d', 'OLD'))
        // FIX 1: Only show the relevant reviewer column based on MR type
        def reviewerDisplay = mr.isDockerMR
            ? mr.dockerReviewers.collect { "@${it}" }.join(', ')
            : mr.repoReviewers.collect { "@${it}" }.join(', ')
        if (!reviewerDisplay) reviewerDisplay = '<em>—</em>'
        def bg = idx % 2 == 0 ? '#ffffff' : '#f4f8fb'
        rows += """<tr style="background:${bg};">
  <td style="${td}">${mr.repo}</td>
  <td style="${td}">${typeBadge}${dockerBadge}</td>
  <td style="${td}"><a href="${mr.link}" style="color:#2980b9;text-decoration:none;">${mr.title}</a></td>
  <td style="${td}"><code style="font-size:11px;">${mr.branch}</code></td>
  <td style="${td}">${ageBadge}</td>
  <td style="${td}">${reviewerDisplay}</td>
</tr>"""
    }
    def th = 'background:#3498db;color:#fff;padding:8px 10px;text-align:left;font-size:13px;'
    return """<table style="border-collapse:collapse;width:100%;margin-top:8px;margin-bottom:20px;">
  <tr>
    <th style="${th}width:12%;">Repo</th>
    <th style="${th}width:14%;">Type</th>
    <th style="${th}width:28%;">MR Title</th>
    <th style="${th}width:20%;">Branch</th>
    <th style="${th}width:10%;">Status</th>
    <th style="${th}width:16%;">Reviewer</th>
  </tr>${rows}</table>"""
}

